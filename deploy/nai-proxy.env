# nai-proxy 环境变量 —— 由 systemd 读取（见 nai-proxy.service 的 EnvironmentFile）
# 复制到 /etc/nai-proxy.env，填好真值，chmod 600（只有 root 能读）。
# 这台机器就是「填 key 的地方」——换 key = 改这里的 NAI_KEY 然后 restart。

# ---- 必填 ----
NAI_KEY=在这里填你的真 NAI token
ACCESS_TOKENS=friendA-xxxx,friendB-yyyy,friendC-zzzz

# ---- 端口（Caddy 会反代到这个本地端口；不对外暴露）----
PORT=3000

# ---- 限速 / 回收（默认值即可，想调再改）----
MIN_GAP_MS=8000
MAX_GAP_MS=12000
ENCODE_MIN_GAP_MS=3000
RESULT_TTL_MS=600000
MAX_JOBS=200
NAI_API_BASE_URL=https://image.novelai.net

# ---- 可选：参数上限防误操作烧 Anlas（0 = 不限制）----
MAX_SAMPLES=0
MAX_STEPS=0

# ---- 可选：车主用量统计端点（设了才开 /stats）----
# ADMIN_TOKEN=只有你自己知道的一串

# ---- 活动热力图（90 天 SQLite 小时聚合）----
STATS_DB_PATH=/var/lib/nai-proxy/stats.sqlite
STATS_RETENTION_DAYS=90
USER_PROFILES_JSON={"friendA-xxxx":{"name":"Alice","timeZone":"Asia/Shanghai"},"friendB-yyyy":{"name":"Bob","timeZone":"America/Los_Angeles"},"friendC-zzzz":{"name":"Carol","timeZone":"UTC"}}
