# 复制为 .env（本地）或在 Render 后台逐项填写。.env 已被 .gitignore 忽略，不会进仓库。

# 共享 NAI token —— 换 key 就改这里（Render 上改了会自动重部署）。代码里不含 key。
NAI_KEY=

# 逗号分隔的访问令牌，一人一个，方便单独吊销。朋友端只填令牌，不接触 NAI key。
# 随便取够长够随机的字符串即可，例如用 `openssl rand -hex 16` 各生成一个。
ACCESS_TOKENS=friendA-change-me,friendB-change-me

# 总体限速：相邻请求起点最小间隔（毫秒）。默认 12000 ≈ 5/分钟。
MIN_GAP_MS=12000

# 结果保留时长（毫秒），超时回收释放内存。默认 600000 = 10 分钟。
RESULT_TTL_MS=600000

# 可选参数上限（0 = 不限制），防误操作烧 Anlas。
MAX_SAMPLES=0
MAX_STEPS=0

# NAI 接口基址。默认真地址；本地验证逻辑时才指向 mock（见 README）。
# NAI_BASE_URL=https://image.novelai.net

# Render 会自动注入 PORT；本地默认 3000。
# PORT=3000
